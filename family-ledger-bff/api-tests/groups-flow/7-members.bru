meta {
  name: List members
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/members
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("создатель с доходом", function () {
    expect(res.body.length).to.equal(1);
    expect(res.body[0].income).to.equal(5000000);
    expect(res.body[0].role).to.equal("owner");
  });
}

meta {
  name: Create invite code
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/groups/{{groupId}}/invite
  body: none
  auth: none
}

script:post-response {
  bru.setVar("inviteCode", res.body.code);
}

assert {
  res.status: eq 200
}

tests {
  test("4 цифры и срок жизни", function () {
    expect(res.body.code).to.match(/^\d{4}$/);
    expect(res.body.expiresAt).to.be.a("string");
  });
}

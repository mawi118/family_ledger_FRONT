meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "Testpass123!",
    "firstName": "Тест"
  }
}

script:pre-request {
  bru.setVar("testEmail", "test-" + Date.now() + "@example.com");
}

assert {
  res.status: eq 201
}
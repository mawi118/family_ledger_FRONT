meta {
  name: Login with wrong password (must fail)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "Wrong-pass9!"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("единая ошибка авторизации", function () {
    expect(res.body.error).to.equal("Неверное имя пользователя или пароль");
  });
}